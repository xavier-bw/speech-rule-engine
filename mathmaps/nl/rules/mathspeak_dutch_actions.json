{
  "locale": "nl",
  "modality": "speech",
  "domain": "mathspeak",
  "kind": "actions",
  "rules": [
    [
      "Action",
      "collapsed",
      "[t] \"opgesom\"; [n] . (engine:modality=summary, grammar:?collapsed)"
    ],
    ["Action", "blank-cell-empty", "[t] \"Leeg\""],
    ["Action", "blank-line-empty", "[t] \"Leeg\""],
    [
      "Action",
      "font",
      "[t] @font (grammar:localFont); [n] . (grammar:ignoreFont=@font)"
    ],
    [
      "Action",
      "font-double-struck",
      "[n] . (grammar:ignoreFont=@font); [t] @font (grammar:localFont)"
    ],
    [
      "Action",
      "mixed-number",
      "[n] children/*[1]; [t] \"en\"; [n] children/*[2]"
    ],
    [
      "Action",
      "number-with-chars",
      "[t] \"getal\"; [m] CQFspaceoutNumber (grammar:protected)"
    ],
    [
      "Action",
      "number-with-chars-brief",
      "[t] \"Nom\"; [m] CQFspaceoutNumber (grammar:protected)"
    ],
    [
      "Action",
      "number-as-upper-word",
      "[t] \"hoofletters\"; [t] CSFspaceoutText"
    ],
    ["Action", "number-baseline", "[t] \"Basislyn\"; [n] . (grammar:baseline)"],
    [
      "Action",
      "number-baseline-brief",
      "[t] \"Basis\"; [n] . (grammar:baseline)"
    ],
    [
      "Action",
      "number-baseline-font",
      "[t] \"Basislyn\"; [t] @font; [n] . (grammar:ignoreFont=@font)"
    ],
    [
      "Action",
      "number-baseline-font-brief",
      "[t] \"Basis\"; [t] @font; [n] . (grammar:ignoreFont=@font)"
    ],
    ["Action", "negative-number", "[t] \"negatief\"; [n] children/*[1]"],
    ["Action", "negative", "[t] \"minus\"; [n] children/*[1]"],
    [
      "Action",
      "division",
      "[n] children/*[1]; [t] \"gedeel deur\"; [n] children/*[2]"
    ],
    ["Action", "subtraction", "[m] children/* (separator:\"minus\")"],
    [
      "Action",
      "fences-neutral",
      "[t] \"begin absolute Waarde\"; [n] children/*[1]; [t] \"einde Absolute Waarde\""
    ],
    [
      "Action",
      "fences-neutral-sbrief",
      "[t] \"Absolute Waarde\"; [n] children/*[1]; [t] \"einde Absolute Waarde\""
    ],
    [
      "Action",
      "fences-metric",
      "[t] \"Begin Metries\"; [n] children/*[1]; [t] \"einde Metries\""
    ],
    [
      "Action",
      "fences-metric-sbrief",
      "[t] \"Metries\"; [n] children/*[1]; [t] \"einde metries\""
    ],
    ["Action", "empty-set", "[t] \"leë versameling\""],
    [
      "Action",
      "fences-set",
      "[t] \"begin versameling\"; [n] children/*[1]; [t] \"einde versameling\""
    ],
    [
      "Action",
      "fences-set-sbrief",
      "[t] \"Versameling\"; [n] children/*[1]; [t] \"einde Versameling\""
    ],
    ["Action", "factorial", "[t] \"faktoriaal\""],
    ["Action", "minus", "[t] \"minus\""],
    [
      "Action",
      "continued-fraction-outer",
      "[t] \"voortgesette Breuk\"; [n] children/*[1]; [t] \"Oor\"; [n] children/*[2]"
    ],
    [
      "Action",
      "continued-fraction-outer-brief",
      "[t] \"voortgesette Breuk\"; [n] children/*[1]; [t] \"Oor\"; [n] children/*[2]"
    ],
    [
      "Action",
      "continued-fraction-inner",
      "[t] \"Begin Breuk\"; [n] children/*[1]; [t] \"Oor\"; [n] children/*[2]"
    ],
    [
      "Action",
      "continued-fraction-inner-brief",
      "[t] \"Begin Breuk\"; [n] children/*[1]; [t] \"Oor\"; [n] children/*[2]"
    ],
    [
      "Action",
      "continued-fraction-inner-sbrief",
      "[t] \"Breuk\"; [n] children/*[1]; [t] \"Oor\"; [n] children/*[2]"
    ],
    [
      "Action",
      "integral",
      "[n] children/*[1]; [t] \"Onderskrif\"; [n] children/*[2]; [t] \"Boskrif\"; [n] children/*[3]; [t] \"Basislyn\""
    ],
    [
      "Action",
      "integral-brief",
      "[n] children/*[1]; [t] \"Onder\"; [n] children/*[2]; [t] \"Bo\"; [n] children/*[3]; [t] \"Basis\""
    ],
    [
      "Action",
      "square",
      "[n] children/*[1]; [t] \"kwadraat\" (span:children/*[2])"
    ],
    [
      "Action",
      "cube",
      "[n] children/*[1]; [t] \"kubbiek\" (span:children/*[2])"
    ],
    ["Action", "prime", "[n] children/*[1]; [n] children/*[2]"],
    [
      "Action",
      "counted-prime",
      "[t] count(children/*) (grammar:numbers2alpha); [t] \"priem\""
    ],
    [
      "Action",
      "counted-prime-multichar",
      "[t] string-length(text()) (grammar:numbers2alpha); [t] \"priem\""
    ],
    [
      "Action",
      "overscore",
      "[t] \"pas Bovenste aan\"; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    [
      "Action",
      "overscore-brief",
      "[t] \"pas aan boven; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    [
      "Action",
      "double-overscore",
      "[t] \"Pas aan Bovenkant Bovenkant\"; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    [
      "Action",
      "double-overscore-brief",
      "[t] \"Pas aan dubbel boven; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    [
      "Action",
      "underscore",
      "[t] \"Pas aan onder\"; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    [
      "Action",
      "underscore-brief",
      "[t] \"Pas aan onder\"; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    [
      "Action",
      "double-underscore",
      "[t] \"Pas aan dubbel onder\"; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    [
      "Action",
      "double-underscore-brief",
      "[t] \"Pas aan dubbel onder\"; [n] children/*[1]; [t] \"met\"; [n] children/*[2]"
    ],
    ["Action", "overbar", "[n] children/*[1]; [t] \"lijn boven\""],
    ["Action", "underbar", "[n] children/*[1]; [t] \"lijn onder\""],
    ["Action", "overtilde", "[n] children/*[1]; [t] \"over tilde\""],
    ["Action", "undertilde", "[n] children/*[1]; [t] \"onder tilde\""],
    [
      "Action",
      "matrix",
      "[t] \"Begin\"; [t] count(children/*); [t] \"By\"; [t] count(children/*[1]/children/*); [t] \"Matrix\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde Matrix\""
    ],
    [
      "Action",
      "matrix-sbrief",
      "[t] count(children/*); [t] \"By\"; [t] count(children/*[1]/children/*); [t] \"Matrix\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde Matrix\""
    ],
    [
      "Action",
      "matrix-row",
      "[m] children/* (ctxtFunc:CTFordinalCounter, context:\"Kolom\", pause:200)"
    ],
    [
      "Action",
      "row-with-label",
      "[t] \"met label\"; [n] content/*[1]; [t] \"einde label\" (pause:200); [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Kolom\")"
    ],
    [
      "Action",
      "row-with-label-brief",
      "[t] \"label\"; [n] content/*[1]; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Kolom\")"
    ],
    [
      "Action",
      "row-with-text-label",
      "[t] \"label\"; [t] CSFRemoveParens; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Kolom\")"
    ],
    ["Action", "empty-row", "[t] \"leeg\""],
    ["Action", "empty-cell", "[t] \"leeg\" (pause:300)"],
    [
      "Action",
      "determinant",
      "[t] \"Begin\"; [t] count(children/*); [t] \"By\"; [t] count(children/*[1]/children/*); [t] \"Determinant\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde Determinant\""
    ],
    [
      "Action",
      "determinant-sbrief",
      "[t] count(children/*); [t] \"By\"; [t] count(children/*[1]/children/*); [t] \"Determinant\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde Determinant\""
    ],
    [
      "Action",
      "determinant-simple",
      "[t] \"Begin\"; [t] count(children/*); [t] \"By\"; [t] count(children/*[1]/children/*); [t] \"Determinant\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry\", grammar:simpleDet); [t] \"einde Determinant\""
    ],
    [
      "Action",
      "determinant-simple-sbrief",
      "[t] count(children/*); [t] \"By\"; [t] count(children/*[1]/children/*); [t] \"Determinant\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry\", grammar:simpleDet); [t] \"einde Determinant\""
    ],
    [
      "Action",
      "layout",
      "[t] \"Begin uitleg\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde uitleg\""
    ],
    [
      "Action",
      "layout-sbrief",
      "[t] \"uitleg\"; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde uitleg\""
    ],
    [
      "Action",
      "binomial",
      "[t] \"Begin Binomiaal of Matrix\"; [n] children/*[1]/children/*[1]; [t] \"Kies\"; [n] children/*[2]/children/*[1]; [t] \"einde Binomiaal of Matrix\""
    ],
    [
      "Action",
      "binomial-sbrief",
      "[t] \"Binomiaal of Matrix\"; [n] children/*[1]/children/*[1]; [t] \"Kies\"; [n] children/*[2]/children/*[1]; [t] \"einde Binomiaal of Matrix\""
    ],
    [
      "Action",
      "cases",
      "[t] \"Begin uitleg\"; [t] \"vergroot\"; [n] content/*[1]; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde uitleg\""
    ],
    [
      "Action",
      "cases-sbrief",
      "[t] \"Uitleg\"; [t] \"Vergroot\"; [n] content/*[1]; [m] children/* (ctxtFunc:CTFordinalCounter, context:\"Ry \"); [t] \"einde uitleg\""
    ],
    [
      "Action",
      "line-with-label",
      "[t] \"met label\"; [n] content/*[1]; [t] \"einde label\" (pause:200); [m] children/*"
    ],
    [
      "Action",
      "line-with-label-brief",
      "[t] \"label\"; [n] content/*[1] (pause:200); [m] children/*"
    ],
    [
      "Action",
      "line-with-text-label",
      "[t] \"label\"; [t] CSFRemoveParens; [m] children/*"
    ],
    ["Action", "empty-line", "[t] \"leeg\""],
    [
      "Action",
      "empty-line-with-label",
      "[t] \"met label\"; [n] content/*[1]; [t] \"einde label\" (pause:200); [t] \"Leeg\""
    ],
    [
      "Action",
      "empty-line-with-label-brief",
      "[t] \"label\"; [n] content/*[1] (pause:200); [t] \"Leeg\""
    ],
    [
      "Action",
      "enclose",
      "[t] \"Begin omsluiting\"; [t] @role (grammar:localEnclose); [n] children/*[1]; [t] \"einde omsluiting\""
    ],
    ["Action", "leftbar", "[t] \"linker streep\"; [n] children/*[1]"],
    ["Action", "rightbar", "[n] children/*[1]; [t] \"rechter streep\""],
    [
      "Action",
      "crossout",
      "[t] \"doodgetrek\"; [n] children/*[1]; [t] \"einde doodgetrek\""
    ],
    [
      "Action",
      "cancel",
      "[t] \"vervang\"; [n] children/*[1]/children/*[1]; [t] \"met\"; [n] children/*[2]; [t] \"einde vervang\""
    ],
    [
      "Action",
      "cancel-reverse",
      "[t] \"vervang\"; [n] children/*[2]/children/*[1]; [t] \"met\"; [n] children/*[1]; [t] \"einde vervang\""
    ],
    [
      "Action",
      "multi-inference",
      "[t] \"afleidingsreël\"; [m] content/*; [t] \"met gevolgtrekking\"; [n] children/*[1]; [t] \"en\"; [t] count(children/*[2]/children/*); [t] \"uitgangspunt\""
    ],
    [
      "Action",
      "inference",
      "[t] \"afleidingsreël\"; [m] content/*; [t] \"met gevolgtrekking\"; [n] children/*[1]; [t] \"en\"; [t] count(children/*[2]/children/*); [t] \"uitgangspunt\""
    ],
    [
      "Action",
      "premise",
      "[m] children/* (ctxtFunc:CTFordinalCounter, context:\"uitgangspunt \")"
    ],
    ["Action", "conclusion", "[n] children/*[1]"],
    ["Action", "label", "[t] \"label\"; [n] children/*[1]"],
    ["Action", "axiom", "[t] \"aksioom\"; [m] children/*[1]"],
    ["Action", "empty-axiom", "[t] \"leë aksioom\""]
  ]
}
