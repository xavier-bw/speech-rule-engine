{
  "locale": "nl",
  "modality": "summary",
  "kind": "actions",
  "rules": [
    ["Action", "abstr-identifier-long", "[t] \"lang identifiseerder\""],
    ["Action", "abstr-identifier", "[t] \"identifiseerder\""],
    ["Action", "abstr-number-long", "[t] \"lang getal\""],
    ["Action", "abstr-number", "[t] \"getal\""],
    ["Action", "abstr-mixed-number-long", "[t] \"lang gemengde getal\""],
    ["Action", "abstr-mixed-number", "[t] \"gemengde getal\""],
    ["Action", "abstr-text", "[t] \"teks\""],
    ["Action", "abstr-function", "[t] \"functionele uitdrukking\""],
    ["Action", "abstr-function-brief", "[t] \"functie\""],
    ["Action", "abstr-lim", "[t] \"limiet functie\""],
    ["Action", "abstr-lim-brief", "[t] \"limïet\""],
    ["Action", "abstr-fraction", "[t] \"breuk\""],
    ["Action", "abstr-fraction-brief", "[t] \"breuk\""],
    ["Action", "abstr-continued-fraction", "[t] \"voortgezette breuk\""],
    ["Action", "abstr-continued-fraction-brief", "[t] \"voortgezette breuk\""],
    ["Action", "abstr-sqrt", "[t] \"vierkantswortel\""],
    ["Action", "abstr-sqrt-nested", "[t] \"geneste vierkantswortel\""],
    [
      "Action",
      "abstr-root-end",
      "[t] \"wortel van index\"; [n] children/*[1] (engine:modality=speech); [t] \"einde index\""
    ],
    [
      "Action",
      "abstr-root",
      "[t] \"wortel van index\"; [n] children/*[1] (engine:modality=speech)"
    ],
    ["Action", "abstr-root-brief", "[t] \"wortel\""],
    [
      "Action",
      "abstr-root-nested-end",
      "[t] \"geneste wortel van index\"; [n] children/*[1] (engine:modality=speech); [t] \"end index\""
    ],
    [
      "Action",
      "abstr-root-nested",
      "[t] \"geneste wortel van index\"; [n] children/*[1] (engine:modality=speech)"
    ],
    ["Action", "abstr-root-nested-brief", "[t] \"geneste wortel\""],
    ["Action", "abstr-superscript", "[t] \"mag\""],
    ["Action", "abstr-subscript", "[t] \"subscript\""],
    ["Action", "abstr-subsup", "[t] \"mag met subscript\""],
    [
      "Action",
      "abstr-infixop",
      "[t] @role (grammar:localRole); [t] \"met\"; [t] count(./children/*); [t] \"elementen\""
    ],
    [
      "Action",
      "abstr-infixop-var",
      "[t] @role (grammar:localRole); [t] \"met wisselende hoeveelheid elementen\""
    ],
    ["Action", "abstr-infixop-brief", "[t] @role (grammar:localRole)"],
    [
      "Action",
      "abstr-addition",
      "[t] \"som met\"; [t] count(./children/*); [t] \"termen\""
    ],
    ["Action", "abstr-addition-brief", "[t] \"som\""],
    ["Action", "abstr-addition-var", "[t] \"som met wisselend aantal termen\""],
    [
      "Action",
      "abstr-multiplication",
      "[t] \"produkt met\"; [t] count(./children/*); [t] \"faktoren\""
    ],
    ["Action", "abstr-multiplication-brief", "[t] \"produkt\""],
    [
      "Action",
      "abstr-multiplication-var",
      "[t] \"produkt met wisselende hoeveelheid faktoren\""
    ],
    [
      "Action",
      "abstr-vector",
      "[t] count(./children/*); [t] \"dimensionele vektor\""
    ],
    ["Action", "abstr-vector-brief", "[t] \"vektor\""],
    ["Action", "abstr-vector-var", "[t] \"n dimensionele vektor\""],
    ["Action", "abstr-binomial", "[t] \"binomiaal\""],
    [
      "Action",
      "abstr-determinant",
      "[t] count(./children/*); [t] \"dimensionele determinant\""
    ],
    ["Action", "abstr-determinant-brief", "[t] \"determinant\""],
    ["Action", "abstr-determinant-var", "[t] \"n dimensional determinant\""],
    [
      "Action",
      "abstr-squarematrix",
      "[t] count(./children/*); [t] \"dimensionele vierkant matrix\""
    ],
    ["Action", "abstr-squarematrix-brief", "[t] \"vierkant matrix\""],
    [
      "Action",
      "abstr-rowvector",
      "[t] count(./children/row/children/*); [t] \"dimensionele rij vektor\""
    ],
    ["Action", "abstr-rowvector-brief", "[t] \"rij vektor\""],
    ["Action", "abstr-rowvector-var", "[t] \"n dimensionele rij vektor\""],
    [
      "Action",
      "abstr-matrix",
      "[t] count(children/*); [t] \"by\"; [t] count(children/*[1]/children/*); [t] \"matrix\""
    ],
    ["Action", "abstr-matrix-brief", "[t] \"matrix\""],
    ["Action", "abstr-matrix-var", "[t] \"n by m dimensionele matrix\""],
    [
      "Action",
      "abstr-cases",
      "[t] \"gevalstelling\"; [t] \"met\"; [t] count(children/*); [t] \"gevalle\""
    ],
    ["Action", "abstr-cases-brief", "[t] \"gevalstelling\""],
    [
      "Action",
      "abstr-cases-var",
      "[t] \"gevalstelling met wisselende hoeveelheid gevallen\""
    ],
    [
      "Action",
      "abstr-punctuated",
      "[n] content/*[1]; [t] \"opgesplitste lijst\"; [t] \"met lengte\"; [t] count(children/*) - count(content/*)"
    ],
    [
      "Action",
      "abstr-punctuated-brief",
      "[n] content/*[1]; [t] \"opgesplitste lijst\""
    ],
    [
      "Action",
      "abstr-punctuated-var",
      "[n] content/*[1]; [t] \"opgesplitste lijst\"; [t] \"met wisselende lengte\""
    ],
    ["Action", "abstr-bigop", "[n] content/*[1]"],
    ["Action", "abstr-integral", "[t] \"integraal\""],
    ["Action", "abstr-relation", "[t] @role (grammar:localRole)"],
    [
      "Action",
      "abstr-relation-seq",
      "[t] @role (grammar:localRole); [t] \"sequentie\"; [t] \"met\"; [t] count(./children/*); [t] \"elementen\""
    ],
    [
      "Action",
      "abstr-relation-seq-brief",
      "[t] @role (grammar:localRole); [t] \"sequentie\""
    ],
    [
      "Action",
      "abstr-relation-var",
      "[t] @role (grammar:localRole); [t] \"sequentie\"; [t] \"met wisselende hoeveelheid elementen\""
    ],
    [
      "Action",
      "abstr-multirel",
      "[t] \"relatie sequentie\"; [t] \"met\"; [t] count(./children/*); [t] \"elementen\""
    ],
    ["Action", "abstr-multirel-brief", "[t] \"relatie sequentie\""],
    [
      "Action",
      "abstr-multirel-var",
      "[t] \"relatie sequentie met een wisselende aantal elementen\""
    ],
    [
      "Action",
      "abstr-table",
      "[t] \"tabêl met\"; [t] count(children/*); [t] \"rye en\"; [t] count(children/*[1]/children/*); [t] \"kolommen\""
    ],
    ["Action", "abstr-line", "[t] \"in\"; [t] @role (grammar:localRole)"],
    [
      "Action",
      "abstr-row",
      "[t] \"in\"; [t] @role (grammar:localRole); [t] count(preceding-sibling::..); [t] \"met\"; [t] count(children/*); [t] \"kolommen\""
    ],
    ["Action", "abstr-cell", "[t] \"in\"; [t] @role (grammar:localRole)"]
  ]
}
